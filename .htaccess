# Clean URLs — serve foo.html when the visitor asks for /foo
Options +FollowSymLinks -MultiViews

RewriteEngine On

# If the request maps to a real file or directory, serve it as-is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Otherwise try adding .html
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Redirect /kanger/foo.html -> /kanger/foo (keeps URLs clean if someone types the .html)
RewriteCond %{THE_REQUEST} \s/kanger/+([^\s?]+?)\.html[\s?] [NC]
RewriteRule ^ /kanger/%1 [R=301,L]
